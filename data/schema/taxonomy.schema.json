{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "taxonomy.schema.json",
  "title": "Taxonomy",
  "description": "과목 → 주제 → 개념 3단계 분류 체계 (data/taxonomy.json). slug는 세 단계 전체에서 유일하며 main에 들어간 뒤에는 삭제하지 않는다.",
  "type": "array",
  "items": {
    "$ref": "#/$defs/subject"
  },
  "$defs": {
    "slug": {
      "description": "소문자·숫자·하이픈으로 된 안정적 식별자.",
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
    },
    "name": {
      "description": "한국어 표시명.",
      "type": "string",
      "minLength": 1,
      "maxLength": 100
    },
    "subject": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "tracks",
        "topics"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/slug"
        },
        "name": {
          "$ref": "#/$defs/name"
        },
        "tracks": {
          "description": "이 과목이 적용되는 트랙 (written, practical 중 하나 이상).",
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "written",
              "practical"
            ]
          }
        },
        "topics": {
          "description": "과목 아래 주제 목록.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/topic"
          }
        }
      }
    },
    "topic": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "concepts"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/slug"
        },
        "name": {
          "$ref": "#/$defs/name"
        },
        "concepts": {
          "description": "주제 아래 개념 목록 (집계의 기본 단위).",
          "type": "array",
          "items": {
            "$ref": "#/$defs/concept"
          }
        }
      }
    },
    "concept": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/slug"
        },
        "name": {
          "$ref": "#/$defs/name"
        },
        "deprecated": {
          "description": "폐기된 개념이면 true. 노드는 삭제하지 않는다.",
          "type": "boolean"
        },
        "replaced_by": {
          "description": "폐기 개념을 대체하는 같은 과목의 개념 slug.",
          "$ref": "#/$defs/slug"
        }
      },
      "if": {
        "properties": {
          "deprecated": {
            "const": true
          }
        },
        "required": [
          "deprecated"
        ]
      },
      "then": {
        "required": [
          "replaced_by"
        ]
      },
      "else": {
        "not": {
          "required": [
            "replaced_by"
          ]
        }
      }
    }
  }
}
